---
import { profile } from "../data/profile";

const [role, ...tags] = profile.headline.split("|").map((s) => s.trim());
---

<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={profile.summary} />
		<meta name="generator" content={Astro.generator} />
		<title>{profile.name} — {role}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500&family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<div class="bg-fx" aria-hidden="true">
			<span></span>
			<span></span>
			<span></span>
		</div>
		<div class="page">
			<aside class="sidebar">
				<div class="avatar-wrap">
					<img class="avatar" src={profile.photo} alt={profile.name} width="140" height="140" />
				</div>
				<h1>{profile.name}</h1>
				<p class="role">{role}</p>
				{
					tags.length > 0 && (
						<ul class="tags">
							{tags.map((tag) => <li>{tag}</li>)}
						</ul>
					)
				}
				<p class="location">{profile.location}</p>

				<div class="contact">
					<a href={`mailto:${profile.email}`}>{profile.email}</a>
					{
						profile.links.map((link) => (
							<a href={link.url} target="_blank" rel="noopener noreferrer">
								{link.label}
							</a>
						))
					}
				</div>

				<div class="sidebar-section">
					<h2>Skills</h2>
					<ul class="pills">
						{profile.skills.map((skill) => <li>{skill}</li>)}
					</ul>
				</div>

				<div class="sidebar-section">
					<h2>Idiomas</h2>
					<ul class="plain-list">
						{profile.languages.map((language) => <li>{language}</li>)}
					</ul>
				</div>
			</aside>

			<main class="content">
				<div class="content-inner">
					<section>
						<h2>Sobre</h2>
						<p class="lede">{profile.summary}</p>
					</section>

					<section>
						<h2>Experiência</h2>
						<ol class="timeline">
							{
								profile.experience.map((job) => (
									<li class={job.period.includes("Presente") ? "is-current" : ""}>
										<h3>{job.role}</h3>
										<p class="company">{job.company}</p>
										<p class="meta">
											{job.period} — {job.location}
										</p>
										{job.highlights.length > 0 && (
											<ul>
												{job.highlights.map((point) => <li>{point}</li>)}
											</ul>
										)}
									</li>
								))
							}
						</ol>
					</section>

					<section>
						<h2>Formação</h2>
						<ul class="plain-cards">
							{
								profile.education.map((item) => (
									<li>
										<strong>{item.degree}</strong>
										<span class="meta">{item.institution} · {item.period}</span>
									</li>
								))
							}
						</ul>
					</section>

					<section>
						<h2>Certificações</h2>
						<ul class="plain-cards">
							{profile.certifications.map((cert) => <li>{cert}</li>)}
						</ul>
					</section>
				</div>
			</main>
		</div>
	</body>
</html>

<style>
	:root {
		color-scheme: dark;
		--sidebar-bg: rgba(5, 6, 13, 0.88);
		--sidebar-fg: #eaf6ff;
		--sidebar-muted: #7d8bab;
		--accent: #00e5ff;
		--accent-2: #ff2ea6;
		--content-bg: rgba(11, 14, 26, 0.86);
		--content-fg: #e6f1ff;
		--muted: #8892b0;
		--card-bg: rgba(0, 229, 255, 0.05);
		--card-border: rgba(0, 229, 255, 0.25);
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		font-family: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
		line-height: 1.6;
		background-image:
			linear-gradient(rgba(0, 229, 255, 0.04) 1px, transparent 1px),
			linear-gradient(90deg, rgba(0, 229, 255, 0.04) 1px, transparent 1px);
		background-size: 42px 42px;
	}

	h1,
	h2,
	h3 {
		font-family: "Space Grotesk", system-ui, sans-serif;
		font-weight: 600;
	}

	.page {
		display: grid;
		grid-template-columns: 300px 1fr;
		min-height: 100vh;
	}

	/* Sidebar */

	.sidebar {
		background: var(--sidebar-bg);
		color: var(--sidebar-fg);
		padding: 3rem 2rem;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		position: sticky;
		top: 0;
		height: 100vh;
		overflow-y: auto;
	}

	.avatar-wrap {
		width: 140px;
		height: 140px;
		border-radius: 50%;
		overflow: hidden;
		flex-shrink: 0;
		border: 3px solid var(--accent);
		box-shadow:
			0 0 18px rgba(0, 229, 255, 0.55),
			0 0 44px rgba(255, 46, 166, 0.25);
		animation: avatar-border-glitch 9s ease-in-out infinite;
	}

	.avatar {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		animation: photo-glitch 9s ease-in-out infinite;
	}

	@keyframes avatar-border-glitch {
		0%,
		92%,
		93.4%,
		94.5%,
		100% {
			border-color: var(--accent);
		}
		92.5%,
		94% {
			border-color: var(--accent-2);
		}
	}

	@keyframes photo-glitch {
		0%,
		92%,
		100% {
			filter: none;
			clip-path: inset(0 0 0 0);
			transform: translate(0, 0);
		}
		92.5% {
			filter: hue-rotate(90deg) saturate(3);
			clip-path: inset(8% 0 46% 0);
			transform: translate(-5px, 0);
		}
		93% {
			filter: hue-rotate(-70deg) saturate(2.5) brightness(1.3);
			clip-path: inset(58% 0 6% 0);
			transform: translate(5px, 0);
		}
		93.4% {
			filter: none;
			clip-path: inset(0 0 0 0);
			transform: translate(-2px, 0);
		}
		94% {
			filter: hue-rotate(180deg);
			clip-path: inset(30% 0 32% 0);
			transform: translate(4px, 0);
		}
		94.5%,
		100% {
			filter: none;
			clip-path: inset(0 0 0 0);
			transform: translate(0, 0);
		}
	}

	.sidebar h1 {
		font-size: 1.6rem;
		margin: 0;
		line-height: 1.25;
	}

	.role {
		margin: -1rem 0 0;
		color: var(--sidebar-muted);
		font-size: 0.95rem;
		font-family: "JetBrains Mono", monospace;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.tags li {
		border: 1px solid color-mix(in srgb, var(--accent) 50%, transparent);
		color: var(--accent);
		padding: 0.15rem 0.55rem;
		border-radius: 999px;
		font-size: 0.72rem;
		font-family: "JetBrains Mono", monospace;
		text-shadow: 0 0 8px rgba(0, 229, 255, 0.5);
	}

	.location {
		margin: -1rem 0 0;
		color: var(--sidebar-muted);
		font-size: 0.85rem;
	}

	.contact {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		font-size: 0.9rem;
	}

	.contact a {
		color: var(--sidebar-fg);
		text-decoration: none;
		border-bottom: 1px solid transparent;
	}

	.contact a:hover {
		color: var(--accent-2);
		border-bottom-color: var(--accent-2);
	}

	.sidebar-section h2 {
		font-family: "JetBrains Mono", monospace;
		font-weight: 500;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--accent);
		margin: 0 0 0.75rem;
	}

	.sidebar-section h2::before {
		content: "// ";
		color: var(--accent-2);
	}

	.pills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.pills li {
		background: color-mix(in srgb, var(--accent) 12%, transparent);
		border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
		color: var(--accent);
		padding: 0.25rem 0.65rem;
		border-radius: 6px;
		font-size: 0.76rem;
		font-family: "JetBrains Mono", monospace;
	}

	.plain-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		font-size: 0.85rem;
		color: var(--sidebar-muted);
	}

	/* Content */

	.content {
		background: var(--content-bg);
		color: var(--content-fg);
		padding: 3.5rem 2.5rem 5rem;
	}

	.content-inner {
		max-width: 640px;
		margin: 0 auto;
	}

	.content section + section {
		margin-top: 3rem;
	}

	.content h2 {
		font-size: 1.4rem;
		position: relative;
		margin: 0 0 1.5rem;
	}

	.content h2::after {
		content: "";
		display: block;
		width: 64px;
		height: 3px;
		background: linear-gradient(90deg, var(--accent), var(--accent-2), var(--accent));
		background-size: 200% 100%;
		border-radius: 2px;
		margin-top: 0.6rem;
		animation: gradient-flow 5s linear infinite;
	}

	.lede {
		font-size: 1.05rem;
		color: var(--muted);
	}

	.timeline {
		position: relative;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.timeline::before {
		content: "";
		position: absolute;
		left: 5px;
		top: 6px;
		bottom: 6px;
		width: 2px;
		background: var(--card-border);
	}

	.timeline li {
		position: relative;
		padding-left: 2rem;
		margin-bottom: 2.25rem;
	}

	.timeline li:last-child {
		margin-bottom: 0;
	}

	.timeline li::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0.4rem;
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--content-bg);
		border: 2px solid var(--accent);
	}

	.timeline li.is-current::before {
		background: var(--accent-2);
		border-color: var(--accent-2);
		animation: pulse-dot 1.8s ease-in-out infinite;
	}

	.timeline h3 {
		font-size: 1.05rem;
		margin: 0;
	}

	.timeline .company {
		font-weight: 600;
		color: var(--accent-2);
		margin: 0.1rem 0;
		font-size: 0.95rem;
		font-family: "JetBrains Mono", monospace;
	}

	.meta {
		color: var(--muted);
		font-size: 0.8rem;
		margin: 0 0 0.5rem;
		font-family: "JetBrains Mono", monospace;
	}

	.timeline ul {
		margin: 0.5rem 0 0;
		padding-left: 1.1rem;
	}

	.timeline li li {
		padding-left: 0;
		margin-bottom: 0.3rem;
	}

	.timeline li li::before {
		content: none;
	}

	.plain-cards {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.plain-cards li {
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		border-radius: 10px;
		padding: 0.85rem 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		font-size: 0.92rem;
		transition: border-color 0.2s, box-shadow 0.2s;
	}

	.plain-cards li:hover {
		border-color: color-mix(in srgb, var(--accent) 60%, transparent);
		box-shadow: 0 0 16px rgba(0, 229, 255, 0.15);
	}

	/* Fundo animado */

	.bg-fx {
		position: fixed;
		inset: 0;
		z-index: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.bg-fx span {
		position: absolute;
		width: 42vw;
		height: 42vw;
		border-radius: 50%;
		filter: blur(90px);
		opacity: 0.35;
	}

	.bg-fx span:nth-child(1) {
		background: var(--accent);
		top: -12%;
		left: -8%;
		animation: float-a 24s ease-in-out infinite alternate;
	}

	.bg-fx span:nth-child(2) {
		background: var(--accent-2);
		bottom: -15%;
		right: -10%;
		animation: float-b 28s ease-in-out infinite alternate;
	}

	.bg-fx span:nth-child(3) {
		background: #8b5cf6;
		top: 35%;
		left: 40%;
		width: 32vw;
		height: 32vw;
		opacity: 0.22;
		animation: float-c 34s ease-in-out infinite alternate;
	}

	.page {
		position: relative;
		z-index: 1;
	}

	@keyframes float-a {
		0% {
			transform: translate(0, 0) scale(1);
		}
		100% {
			transform: translate(10vw, 8vw) scale(1.15);
		}
	}

	@keyframes float-b {
		0% {
			transform: translate(0, 0) scale(1);
		}
		100% {
			transform: translate(-8vw, -10vw) scale(1.1);
		}
	}

	@keyframes float-c {
		0% {
			transform: translate(0, 0) scale(1);
		}
		100% {
			transform: translate(-6vw, 6vw) scale(1.2);
		}
	}

	@keyframes gradient-flow {
		0% {
			background-position: 0% 0;
		}
		100% {
			background-position: -200% 0;
		}
	}

	@keyframes pulse-dot {
		0%,
		100% {
			box-shadow: 0 0 0 0 rgba(255, 46, 166, 0.55);
		}
		50% {
			box-shadow: 0 0 0 7px rgba(255, 46, 166, 0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		* {
			animation: none !important;
			transition: none !important;
		}
	}

	@media (max-width: 780px) {
		.page {
			grid-template-columns: 1fr;
		}

		.sidebar {
			position: static;
			height: auto;
			align-items: center;
			text-align: center;
		}

		.tags {
			justify-content: center;
		}

		.content {
			padding: 2.5rem 1.5rem 4rem;
		}
	}
</style>
